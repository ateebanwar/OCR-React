# LedgerAI Frontend Environment Configuration
# API Mode: 'backend' (connects to shared Node.js/TypeScript backend) or 'mock' (offline development)
VITE_API_MODE=backend
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_ENV=development

# CRITICAL SECURITY NOTE:
# NEVER place GEMINI_API_KEY or any other secret in this file or .env.local!
# The Gemini secret belongs EXCLUSIVELY in the server-side backend environment.
